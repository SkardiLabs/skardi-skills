.DS_Store
./*/.DS_Store
.cursor/
.claude/

# Per-skill iteration workspaces — eval outputs, embedding model weights,
# server.log files, ingest progress manifests. By-product of skill-creator
# runs; not part of the shipped skill.
*-workspace/

# Python bytecode cache from running skill scripts in-place.
__pycache__/
*.pyc

# Runtime artifacts of the retrieval eval fixture (setup.sh regenerates
# all of these; only the generators and YAML sources are tracked).
retrieval/skills/retrieval/evals/fixtures/*.db
retrieval/skills/retrieval/evals/fixtures/*.db-shm
retrieval/skills/retrieval/evals/fixtures/*.db-wal
retrieval/skills/retrieval/evals/fixtures/server.log
retrieval/skills/retrieval/evals/fixtures/server.pid
retrieval/skills/retrieval/evals/fixtures/pipelines.rendered/
retrieval/skills/retrieval/evals/fixtures/ctx.rendered/